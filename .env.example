# ==============================================================================
# OmniKit AI — 环境变量配置模板 (.env.example)
# 复制本文件为 apps/web/.env.local（本地开发）或根目录 .env（Docker 部署）
# 注意：绝不要给任何服务器端 API 密钥添加 NEXT_PUBLIC_ 前缀！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 站点基础信息
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="OmniKit AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. 数据库连接 (PostgreSQL / PGlite 自适应)
# 生产环境（Docker Compose / 独立服务器）请填写标准 PostgreSQL 连接串：
# DATABASE_URL="postgresql://omnikit:change_me_strong_password@postgres:5432/omnikit"
# 本地零守护进程开发环境下，留空或使用 pglite://default 将自动持久化至 ~/.cache/omnikit-ai/pgdata：
# ------------------------------------------------------------------------------
DATABASE_URL="pglite://default"

# ------------------------------------------------------------------------------
# 3. 缓存与速率限制 (Redis / 进程内 LRU 自适应)
# 生产多实例部署请配置 Redis：
# REDIS_URL="redis://redis:6379"
# 留空时自动回退至进程内带 TTL 的 LRU 缓存适配器：
# ------------------------------------------------------------------------------
REDIS_URL=""

# ------------------------------------------------------------------------------
# 4. 统一 AI 模型适配层密钥（仅服务端读取，绝不暴露给浏览器）
# 留空时网站仍可正常启动，AI 功能将提示用户在前端「模型中心」配置自有会话密钥（BYOK）
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 5. 联网搜索与地理信息服务（第二阶段起深度使用，提前预留统一接口）
# 支持 searxng / tavily / brave；未配置付费 Key 时自动启用权威公开源检索模式
# ------------------------------------------------------------------------------
SEARCH_PROVIDER="public"
SEARXNG_BASE_URL=""
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# OpenStreetMap / Nominatim 合规请求标识（建议生产部署填写管理员联系邮箱）
OSM_USER_AGENT="OmniKitAI/0.1.0 (https://localhost; admin@example.com)"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
PHOTON_BASE_URL="https://photon.komoot.io"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# ------------------------------------------------------------------------------
# 6. 安全与反作弊签名密钥（生产环境请使用 openssl rand -hex 32 生成随机串）
# ------------------------------------------------------------------------------
APP_HMAC_SECRET="dev-only-replace-in-production-with-32-byte-random-hex"
